{
  "manifest_version": 3,
  "name": "SecuredApp Activity Tracker",
  "version": "1.0.0",
  "description": "Real-time employee browser activity and productivity tracker for SecuredApp CRM.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SecuredApp Activity Tracker",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
